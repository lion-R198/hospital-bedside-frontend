{
  "name": "hospital-bedside-frontend",
  "version": "1.0.0",
  "description": "床旁信息系统前端 - Vue3 + Element Plus（温暖医疗风格，患者/家属自助服务终端）",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "vite --mode integration",
    "build": "vite build",
    "preview": "vite preview",
    "verify": "vite build --ssr scripts/mock-runtime-check.js --outDir .verify --emptyOutDir && node .verify/mock-runtime-check.js"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.7",
    "echarts": "^5.5.1",
    "element-plus": "^2.8.8",
    "pinia": "^2.2.6",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "sass": "^1.80.6",
    "vite": "^5.4.10"
  }
}
